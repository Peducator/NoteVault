datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                 Int                  @id @default(autoincrement())
  uuid               String?              @unique @default(uuid()) @map("uuid")
  companyName        String               @map("company_name")
  code               String               @unique // Mã định danh công ty (ví dụ: fpt, vinfast, notevault)
  createdAt          DateTime             @default(now()) @map("created_at")
  users              User[]
  categories         Category[]
  transactions       Transaction[]
  bankingInformation BankingInformation[]
  units              Unit[]
  allocations        Allocation[]

  @@map("tenants")
}

// Role cấp công ty. "Admin" KHÔNG lưu ở đây, mà xác định bằng quan hệ unit.ownerId === user.id
enum Role {
  ROOT
  MEMBER
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           Int       @id @default(autoincrement())
  uuid         String?   @unique @default(uuid()) @map("uuid")
  email        String    @unique
  password     String
  name         String?
  employeeCode String?   @map("employee_code") // Mã số nhân viên (ví dụ: VF-1042)
  role         Role      @default(MEMBER)
  deletedAt    DateTime? @map("deleted_at")
  tenantId     Int?      @map("tenant_id")
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  unitId       Int?      @map("unit_id") // Mỗi user thuộc đúng một unit
  unit         Unit?     @relation("UnitMembers", fields: [unitId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  ownedUnits           Unit[]               @relation("UnitOwner")
  categories           Category[]
  transactions         Transaction[]        @relation("TransactionCreator")
  approvedTransactions Transaction[]        @relation("TransactionApprover")
  createdAllocations   Allocation[]         @relation("AllocationCreator")
  bankingInformation   BankingInformation[]

  @@index([tenantId])
  @@index([unitId])
  @@map("users")
}

// Cây tổ chức: tự tham chiếu. Nút lá = "nhóm" (nơi có chi tiêu). Unit cha = "két" giữ tiền để cấp xuống.
model Unit {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parentId  Int?     @map("parent_id") // null = unit gốc của công ty
  parent    Unit?    @relation("UnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Unit[]   @relation("UnitTree")
  name      String
  ownerId   Int      @map("owner_id") // Đúng một owner (admin của nhóm hoặc root)
  owner     User     @relation("UnitOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  members             User[]        @relation("UnitMembers")
  allocationsSent     Allocation[]  @relation("AllocationSource")
  allocationsReceived Allocation[]  @relation("AllocationTarget")
  transactions        Transaction[]

  @@index([tenantId])
  @@index([parentId])
  @@index([ownerId])
  @@map("units")
}

// Lịch sử cấp tiền giữa các unit. Chỉ thêm, không sửa, không xóa.
// Số dư unit tính bằng truy vấn, không lưu thành cột.
model Allocation {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceUnitId Int?     @map("source_unit_id") // null = tiền nạp ban đầu vào unit gốc
  sourceUnit   Unit?    @relation("AllocationSource", fields: [sourceUnitId], references: [id], onDelete: Restrict)
  targetUnitId Int      @map("target_unit_id")
  targetUnit   Unit     @relation("AllocationTarget", fields: [targetUnitId], references: [id], onDelete: Restrict)
  amount       BigInt // VND, số nguyên
  createdById  Int      @map("created_by_id")
  createdBy    User     @relation("AllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([sourceUnitId])
  @@index([targetUnitId])
  @@map("allocations")
}

enum CategoryType {
  EXPENSE
  INCOME
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  type         CategoryType  @default(EXPENSE)
  icon         String?       @default("default")
  userId       Int?          @map("user_id") // null = danh mục hệ thống dùng chung
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     Int?          @map("tenant_id")
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id") // Người tạo giao dịch
  user            User          @relation("TransactionCreator", fields: [userId], references: [id], onDelete: Restrict)
  tenantId        Int           @map("tenant_id")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unitId          Int           @map("unit_id") // Chỉ gắn với unit lá (nhóm), kiểm tra trong code
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  categoryId      Int           @map("category_id")
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount          BigInt // VND, số nguyên (không dùng Float)
  type            CategoryType  @default(EXPENSE)
  transactionDate DateTime      @default(now()) @map("transaction_date")
  note            String?
  s3Key           String?       @map("s3_key") // Đường dẫn ảnh hóa đơn trên S3: tenants/{tenantId}/users/{userId}/receipts/YYYY-MM-DD/{fileName}
  scanStatus      String        @default("CLEAN") @map("scan_status") // PENDING_SCAN, CLEAN, INFECTED

  // Duyệt chi: người duyệt = người quản lý trực tiếp của người tạo. Không xóa giao dịch, từ chối thì đổi trạng thái.
  status          ExpenseStatus @default(SUBMITTED)
  approvedById    Int?          @map("approved_by_id")
  approver        User?         @relation("TransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?     @map("approved_at")
  rejectionReason String?       @map("rejection_reason")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([userId])
  @@index([unitId, status])
  @@index([unitId, transactionDate])
  @@map("transactions")
}

model BankingInformation {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId      Int?     @map("tenant_id")
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  bankName      String   @map("bank_name") // Tên ngân hàng (ví dụ: Techcombank, Vietcombank, MB Bank, ACB...)
  bankCode      String?  @map("bank_code") // Mã định danh ngân hàng (TCB, VCB, MB, ACB, VPB...)
  accountNumber String   @map("account_number") // Số tài khoản ngân hàng
  accountHolder String   @map("account_holder") // Tên chủ tài khoản (in hoa, ví dụ: LAN NGUYEN)
  branch        String?  @map("branch") // Chi nhánh ngân hàng (ví dụ: Chi nhánh Hoàn Kiếm)
  isDefault     Boolean  @default(false) @map("is_default") // Đặt làm tài khoản nhận tiền hoàn ứng mặc định
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("banking_information")
}
